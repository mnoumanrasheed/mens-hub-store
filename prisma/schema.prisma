generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentArea {
  HOMEPAGE
  ABOUT
  CONTACT
  FOOTER
}

enum AnnouncementBackground {
  DARK
  GOLD
  CRITICAL
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  PRODUCT_CLICK
  WHATSAPP_CLICK
}

enum AdminAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_STATE_CHANGED
  CATEGORY_REORDERED
  CATEGORY_DELETED
  SUBCATEGORY_CREATED
  SUBCATEGORY_UPDATED
  SUBCATEGORY_STATE_CHANGED
  SUBCATEGORY_REORDERED
  SUBCATEGORY_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  PRODUCT_STATE_CHANGED
  INVENTORY_UPDATED
  SETTINGS_UPDATED
  CONTENT_UPDATED
  POLICY_UPDATED
  ANNOUNCEMENT_UPDATED
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  displayName  String?
  isActive     Boolean         @default(true)
  tokenVersion Int             @default(0)
  lastLoginAt  DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  auditLogs    AdminAuditLog[]

  @@index([isActive])
}

model AdminAuditLog {
  id        String           @id @default(cuid())
  adminId   String?
  action    AdminAuditAction
  entityId  String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  admin     AdminUser?       @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([entityId, createdAt])
}

model LoginThrottle {
  keyHash         String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

model PublicRateLimit {
  scope           String
  keyHash         String
  count           Int      @default(0)
  windowStartedAt DateTime @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@id([scope, keyHash])
  @@index([updatedAt])
}

model MediaCleanupJob {
  id          String   @id @default(cuid())
  publicId    String   @unique
  kind        String
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  nextAttempt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([nextAttempt])
}

model Category {
  id                  String        @id @default(cuid())
  name                String        @unique
  slug                String        @unique
  description         String?       @db.Text
  imageUrl            String?
  imagePublicId       String?
  bannerImageUrl      String?
  bannerImagePublicId String?
  sortOrder           Int           @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  subcategories       Subcategory[]
  products            Product[]     @relation("ProductCategory")

  @@index([isActive, sortOrder])
}

model Subcategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?   @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[] @relation("ProductSubcategory")

  @@unique([categoryId, slug])
  @@unique([categoryId, name])
  @@unique([id, categoryId])
  @@index([categoryId, isActive, sortOrder])
}

model Product {
  id                String           @id @default(cuid())
  name              String
  sku               String           @unique
  slug              String           @unique
  productType       String?
  categoryId        String
  subcategoryId     String?
  imageUrl          String
  imagePublicId     String?
  originalPrice     Decimal          @db.Decimal(12, 2)
  salePrice         Decimal?         @db.Decimal(12, 2)
  description       String           @db.Text
  material          String?
  totalArticles     Int              @default(0)
  availableArticles Int              @default(0)
  soldArticles      Int              @default(0)
  isPublished       Boolean          @default(false)
  isFeatured        Boolean          @default(false)
  isNewArrival      Boolean          @default(false)
  saleEnabled       Boolean          @default(false)
  saleStartAt       DateTime?        @db.Timestamptz(3)
  saleEndAt         DateTime?        @db.Timestamptz(3)
  seoTitle          String?
  seoDescription    String?          @db.Text
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  category          Category         @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory       Subcategory?     @relation("ProductSubcategory", fields: [subcategoryId, categoryId], references: [id, categoryId], onDelete: Restrict)
  sizes             ProductSize[]
  colors            ProductColor[]
  analyticsEvents   AnalyticsEvent[]

  @@index([isPublished, createdAt])
  @@index([categoryId, isPublished, createdAt])
  @@index([subcategoryId, isPublished, createdAt])
  @@index([isNewArrival, isPublished, createdAt])
  @@index([isFeatured, isPublished, createdAt])
  @@index([saleEnabled, isPublished, saleStartAt, saleEndAt])
  @@index([availableArticles, isPublished])
  @@index([name])
  @@index([productType])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@index([label])
  @@index([productId, sortOrder])
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  name      String
  hexCode   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([name])
  @@index([productId, sortOrder])
}

model SiteSettings {
  id                     String   @id @default("site")
  brandName              String
  tagline                String
  proprietors            String
  phone                  String
  whatsapp               String
  email                  String
  deliveryChargesMessage String   @default("Calculated / Confirmed on WhatsApp")
  whatsappGreeting       String?
  whatsappOrderStatement String?
  instagramUrl           String?
  facebookUrl            String?
  tiktokUrl              String?
  address                String?  @db.Text
  googleMapsUrl          String?
  storeTiming            String?  @db.Text
  lowStockThreshold      Int      @default(3)
  currency               String   @default("PKR")
  websiteTitle           String
  metaDescription        String?  @db.Text
  ogImageUrl             String?
  ogImagePublicId        String?
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model ContentBlock {
  id        String      @id @default(cuid())
  area      ContentArea
  key       String
  title     String?
  content   Json
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([area, key])
  @@index([area, isActive, sortOrder])
}

model PolicyPage {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  content        Json
  isPublished    Boolean   @default(false)
  seoTitle       String?
  seoDescription String?   @db.Text
  publishedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([isPublished, updatedAt])
}

model Announcement {
  id         String                 @id @default(cuid())
  text       String
  linkUrl    String?
  linkLabel  String?
  background AnnouncementBackground @default(DARK)
  enabled    Boolean                @default(false)
  startAt    DateTime?              @db.Timestamptz(3)
  endAt      DateTime?              @db.Timestamptz(3)
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @db.Timestamptz(3)

  @@index([enabled, startAt, endAt, sortOrder])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  productId String?
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([type, productId])
  @@index([productId, type, createdAt])
  @@index([createdAt])
}
