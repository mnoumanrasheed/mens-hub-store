# PostgreSQL / Neon pooled application connection.
DATABASE_URL=

# Optional direct connection for migrations. Prefer an unpooled URL when supplied.
DIRECT_URL=

# Generate a high-entropy value of at least 32 characters. Server only.
SESSION_SECRET=

# Used only by the controlled database seed. The email below is the recommended
# authoritative initial administrator. Choose a password of at least 12 characters.
ADMIN_SEED_EMAIL=mens.hub919@gmail.com
ADMIN_SEED_PASSWORD=

# Cloudinary credentials. API key and secret are server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public canonical origin with no path. Use http://localhost:3000 locally and the
# exact HTTPS production domain on Vercel. This value is embedded in public URLs.
NEXT_PUBLIC_SITE_URL=
